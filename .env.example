FLASK_ENV=development
SECRET_KEY=change-me-flask-secret
JWT_SECRET=change-me-jwt-secret-long-random
PORT=5000

# MongoDB Atlas (hoặc mongodb://127.0.0.1:27017/phimhay_gui cho local)
# Thay YOUR_PASSWORD bằng mật khẩu user DB; ký tự đặc biệt trong password cần URL-encode (@ -> %40)
MONGODB_URI=mongodb+srv://USER:YOUR_PASSWORD@cluster0.ddqf3qa.mongodb.net/phimhay_gui
MONGODB_DB_NAME=phimhay_gui

PHIMAPI_BASE=https://phimapi.com
INITIAL_ADMIN_SECRET=

VNP_TMN_CODE=
VNP_HASH_SECRET=
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNP_RETURN_URL=http://127.0.0.1:5000/api/payment/vnpay-return
VNP_VIP_AMOUNT=100000
VIP_DURATION_DAYS=30

# GUI
API_BASE_URL=http://127.0.0.1:5000

# Flask web edition (run: flask --app run_web.py init-db; flask --app run_web.py run --port 5001)
WEB_SECRET_KEY=replace-with-a-long-random-secret
WEB_DATABASE_URL=sqlite:///instance/phimhay_web.db
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@example.com

WEB_SECRET_KEY=17072005
WEB_DATABASE_URL=sqlite:///instance/phimhay_web.db
